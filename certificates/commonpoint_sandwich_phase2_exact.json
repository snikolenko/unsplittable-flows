    "gamma_recovery_assertions": "assert 0<=h[i]<=1; assert sum(h)==m-1; assert max_R abs(sum(i in R,d[i]*(f[i]-h[i]))) <= eta*sum(d); assert sum_i abs(f[i]-h[i])<=eta*k",
